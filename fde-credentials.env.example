# Rename this file to fde-credentials.env and fill in YOUR real values.
# fde-credentials.env is distributed separately via MS Teams — it is NOT
# part of the starter-pack zip and must NEVER be committed (.gitignore).
# This .example file documents the exact set setup.bat / provision-credentials.ps1 expect.
# Keep it in sync with the secretKeys / variableKeys lists in provision-credentials.ps1
# and the secrets.* / vars.* references in .github/workflows/cd.yml.

# --- Secrets (gh secret set) ---
FDE_SP_CLIENT_ID=
FDE_SP_CLIENT_SECRET=
FDE_SP_TENANT_ID=
FDE_SP_SUBSCRIPTION_ID=
FDE_AGENT_GATEWAY_ENDPOINT=
FDE_AGENT_GATEWAY_KEY=
FDE_LANGFUSE_PUBLIC_KEY=
FDE_LANGFUSE_SECRET_KEY=
FDE_PARTICIPANT_GHCR_PAT=

# --- Variables (gh variable set) ---
FDE_PARTICIPANT_ID=
FDE_POD_ID=
FDE_EVENT_ID=
FDE_NUMERIC_ID=
FDE_GATEWAY_BASE_URL=
# Exact Azure resource names from the infra team / portal (NOT derived here —
# the rg and ca prefixes differ, e.g. rg-fde-exp-blr-1001 vs ca-fde-exp-1001)
FDE_RESOURCE_GROUP=
FDE_CONTAINERAPP_NAME=
# Langfuse host (e.g. https://cloud.langfuse.com). The OTLP endpoint and
# scores endpoint below it (OTLP traces + v3 scores) are derived by cd.yml
# from the two Langfuse keys — no separate OTLP credentials are provisioned.
FDE_LANGFUSE_BASE_URL=